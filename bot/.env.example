# Copy outside the public website, e.g. /etc/solfege-dictations.env, mode 600.
TELEGRAM_BOT_TOKEN=replace-with-BotFather-token
# Comma-separated numeric IDs. Empty = no access except /id.
TELEGRAM_ALLOWED_USER_IDS=
DICTATION_DATA_DIR=/var/lib/solfege-dictations
DICTATION_TIMEZONE=Europe/Moscow
DICTATION_SITE_URL=https://solfege-ear-trainers.tuqo.ru/dictations.html
